# Copy this file to .env and fill in your own values. .env is ignored by git.

# Anthropic API key, used by the chat and the Discord bot (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_api_key_here

# Optional: which Claude model to use (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Discord bot token from the Developer Portal (Bot -> Reset Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: channel IDs where the bot answers every message without being @mentioned
# DISCORD_CHANNEL_IDS=123456789012345678,234567890123456789

# Optional: only these Discord user IDs may use the bot (empty = anyone who can reach it)
# DISCORD_ALLOWED_USER_IDS=
